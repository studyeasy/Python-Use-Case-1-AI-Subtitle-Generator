# ---------- Frontend environment ----------
# Copy this file to ".env.local" for local development:  cp .env.local.example .env.local
#
# NOTE: When you run the stack with Docker Compose you do NOT need this file.
# docker-compose injects NEXT_PUBLIC_API_URL at build time from the ROOT .env
# (via the frontend build arg). This file is only for running `npm run dev`
# directly on your machine, outside Docker.
#
# IMPORTANT: NEXT_PUBLIC_* variables are baked into the browser bundle at BUILD
# time, not read at runtime. If you change this value you must rebuild.
#
# Point it at your backend:
#   - Local dev:        http://localhost:8000
#   - Deployed (prod):  your CloudFront domain, e.g. https://dxxxx.cloudfront.net
NEXT_PUBLIC_API_URL=http://localhost:8000
