# =============================================================================
# Subly Frontend — Next.js environment
# =============================================================================
# Copy this file:   cp sample.env .env.local
#
# WHEN TO USE THIS FILE:
#   Only needed if you run the frontend directly with `npm run dev`.
#   If you use Docker Compose (docker compose up) from the project root,
#   skip this file — NEXT_PUBLIC_API_URL is injected automatically from
#   the root .env via the docker-compose build arg.
#
# IMPORTANT: NEXT_PUBLIC_* variables are baked into the JS bundle at BUILD
# time, not at runtime. After changing this value you must rebuild:
#   Docker:   docker compose up -d --build
#   Direct:   npm run build && npm start
# =============================================================================

# Pick ONE option and uncomment it:

# Option 1 — Local development (Docker Compose or npm run dev on your laptop)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Option 2 — Deployed on EC2 (replace with your EC2 public IP)
# NEXT_PUBLIC_API_URL=http://<EC2-PUBLIC-IP>:8000

# Option 3 — Deployed behind CloudFront (replace with your distribution domain)
# NEXT_PUBLIC_API_URL=https://dxxxxxxxxxxxx.cloudfront.net
