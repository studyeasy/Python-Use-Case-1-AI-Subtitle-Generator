# =============================================================================
# Subly — Flask edition  |  LOCAL DEVELOPMENT
# =============================================================================
# This file is pre-configured for running on your laptop with Docker Desktop.
#
# 1. Copy:   cp sample.env.local .env
# 2. Fill in the 4 lines marked  ★ CHANGE THIS
# 3. Run:    docker compose up -d --build
#
# For AWS EC2 deployment, use .env.example instead and follow its EC2 section.
# =============================================================================

# ---------- Frontend ---------------------------------------------------------
# Pre-set for local — do NOT change these for local dev.
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# ---------- AWS region -------------------------------------------------------
# ★ CHANGE THIS — must match the region of your Cognito user pool.
AWS_REGION=eu-west-2

# ---------- Cognito ----------------------------------------------------------
# AWS Console → Cognito → User Pools → your pool → App integration tab
#
# ★ CHANGE THIS
COGNITO_USER_POOL_ID=eu-west-2_xxxxxxxxx
# ★ CHANGE THIS
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# ★ CHANGE THIS  (App clients → your client → Show client secret)
COGNITO_APP_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tip: set to true locally so you can log in right after sign-up
# without needing to verify your email address.
COGNITO_AUTO_CONFIRM_SIGN_UP=true

# ---------- AWS credentials --------------------------------------------------
# Paste your IAM user access key here for local dev.
# (On EC2 you leave these blank — the IAM role handles it.)
#
# ★ CHANGE THIS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=    # uncomment only if using temporary/STS credentials

# ---------- S3 ---------------------------------------------------------------
# Your bucket must exist in the same region as AWS_REGION.
S3_BUCKET=subly-media-dev
S3_UPLOAD_PREFIX=uploads/
S3_SUBTITLE_PREFIX=subtitles/
S3_PRESIGN_TTL_SECONDS=900

# ---------- Whisper ----------------------------------------------------------
# tiny = fastest, good for local testing. No rebuild needed to switch models.
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ---------- Celery / Redis ---------------------------------------------------
# Matches the redis service in docker-compose.yml — do not change.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---------- Flower -----------------------------------------------------------
FLOWER_BASIC_AUTH=admin:admin

# ---------- Database ---------------------------------------------------------
DATABASE_URL=sqlite:////data/subly.db
