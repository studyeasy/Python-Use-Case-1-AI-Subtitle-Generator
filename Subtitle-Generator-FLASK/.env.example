# =============================================================================
# Subly — Flask edition
# =============================================================================
# 1. Copy this file:   cp .env.example .env
# 2. Fill in the 5 lines marked  ★ CHANGE THIS  — everything else works as-is.
# 3. Run:              docker compose up -d --build
# =============================================================================
#
# ─────────────────────────────────────────────────────────────────────────────
# RUNNING LOCALLY (Docker Desktop on your laptop)
# ─────────────────────────────────────────────────────────────────────────────
# Change only the 5 lines marked ★ CHANGE THIS below.
# Leave NEXT_PUBLIC_API_URL and CORS_ORIGINS exactly as they are.
#
# ─────────────────────────────────────────────────────────────────────────────
# DEPLOYING TO AWS EC2  — make these ADDITIONAL changes in your .env:
# ─────────────────────────────────────────────────────────────────────────────
#
#  1. NEXT_PUBLIC_API_URL  → your CloudFront HTTPS URL (after you create it)
#       NEXT_PUBLIC_API_URL=https://dxxxxxxxxxxxx.cloudfront.net
#
#  2. CORS_ORIGINS         → same CloudFront URL
#       CORS_ORIGINS=https://dxxxxxxxxxxxx.cloudfront.net
#
#  3. AWS_ACCESS_KEY_ID    → leave BLANK  (EC2 IAM role provides credentials)
#       AWS_ACCESS_KEY_ID=
#
#  4. AWS_SECRET_ACCESS_KEY → leave BLANK  (EC2 IAM role provides credentials)
#       AWS_SECRET_ACCESS_KEY=
#
#  That's it — all other values stay the same as local.
#  After editing, rebuild so the new URL bakes into the frontend:
#       docker compose up -d --build
#
# ─────────────────────────────────────────────────────────────────────────────

# ---------- Frontend ---------------------------------------------------------
# Local dev → http://localhost:8000  (already set below, no change needed)
# Deployed  → replace with your CloudFront URL, e.g. https://dxxxx.cloudfront.net
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# ---------- AWS region -------------------------------------------------------
# ★ CHANGE THIS — set to the region where you created your Cognito user pool.
# Common values: eu-west-2  eu-north-1  us-east-1  ap-southeast-1
AWS_REGION=eu-west-2

# ---------- Cognito (authentication) ----------------------------------------
# Find these in: AWS Console → Cognito → User Pools → your pool → App integration
#
# ★ CHANGE THIS
COGNITO_USER_POOL_ID=eu-west-2_xxxxxxxxx
# ★ CHANGE THIS
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# ★ CHANGE THIS  (App clients → your client → Show client secret)
COGNITO_APP_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Set to true in dev so you can log in immediately after sign-up without
# verifying your email. Requires AdminConfirmSignUp IAM permission.
COGNITO_AUTO_CONFIRM_SIGN_UP=false

# ---------- AWS credentials --------------------------------------------------
# LOCAL DEV:  paste your IAM access key + secret here.
# ON EC2:     leave both blank — the attached IAM role provides credentials.
#
# ★ CHANGE THIS (local only — blank on EC2)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=    # uncomment only if you use temporary/STS credentials

# ---------- S3 (media + subtitle storage) ------------------------------------
# Create the bucket in the same region as AWS_REGION before first run.
# Required IAM actions: s3:PutObject  s3:GetObject  s3:DeleteObject
#
# ★ CHANGE THIS — your bucket name
S3_BUCKET=subly-media-dev
# These prefixes are fine as-is:
S3_UPLOAD_PREFIX=uploads/
S3_SUBTITLE_PREFIX=subtitles/
# Pre-signed URL TTL in seconds (900 = 15 min)
S3_PRESIGN_TTL_SECONDS=900

# ---------- Whisper (speech-to-text) -----------------------------------------
# Model sizes (trade-off: speed vs accuracy):
#   tiny   ~39 MB  — fastest, lowest accuracy  (good for testing)
#   base   ~74 MB  — fast, acceptable accuracy
#   small  ~244 MB — recommended for real use
#   medium ~769 MB — high accuracy, needs 4 GB+ RAM
#   large-v3 ~1.5 GB — best accuracy, needs 8 GB+ RAM
# After changing WHISPER_MODEL you MUST rebuild: docker compose build worker
WHISPER_MODEL=tiny
# cpu | cuda  (use cuda only if you have an NVIDIA GPU)
WHISPER_DEVICE=cpu
# int8 = best for CPU  |  float16 = best for GPU  |  float32 = highest precision
WHISPER_COMPUTE_TYPE=int8

# ---------- Celery / Redis (background task queue) ---------------------------
# These match the redis service name in docker-compose.yml — do not change.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---------- Flower (Celery dashboard at http://localhost:5555) ---------------
# Change this password before exposing the app to the internet.
FLOWER_BASIC_AUTH=admin:admin

# ---------- Database ---------------------------------------------------------
# SQLite stored in the shared Docker volume at /data — works out of the box.
DATABASE_URL=sqlite:////data/subly.db
