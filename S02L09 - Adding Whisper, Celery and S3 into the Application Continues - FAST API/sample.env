# Copy this file to .env at the project root and fill in the blanks.

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# ---------- AWS / Cognito ----------
AWS_REGION=eu-west-2
COGNITO_USER_POOL_ID=eu-west-2_xxxxxxxxx
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_APP_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Set to true for dev: after sign_up, backend calls admin_confirm_sign_up so the
# user can log in immediately without verifying an email code.
# Requires AWS credentials with cognito-idp:AdminConfirmSignUp + AdminUpdateUserAttributes.
COGNITO_AUTO_CONFIRM_SIGN_UP=false

# ---------- AWS credentials (used by boto3 for S3 and admin Cognito calls) ----------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=  # uncomment if you use temporary credentials

# ---------- S3 (subtitle + source media storage) ----------
# Create this bucket in the same region as AWS_REGION before bringing the stack up.
# The IAM key above needs s3:PutObject, s3:GetObject and s3:DeleteObject on it.
S3_BUCKET=subly-media-dev
S3_UPLOAD_PREFIX=uploads/
S3_SUBTITLE_PREFIX=subtitles/
S3_PRESIGN_TTL_SECONDS=900

# ---------- Whisper (faster-whisper) ----------
# Model size: tiny | base | small | medium | large-v3
# 'small' is the recommended default — ~470 MB, decent accuracy, works on CPU.
WHISPER_MODEL=small
# cpu | cuda
WHISPER_DEVICE=cpu
# int8 (best for cpu), float16 (gpu), float32 (highest precision)
WHISPER_COMPUTE_TYPE=int8

# ---------- Celery / Redis (background task queue) ----------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---------- Flower (Celery monitoring UI at http://localhost:5555) ----------
# Format is "user:password". Change before exposing outside localhost.
FLOWER_BASIC_AUTH=admin:admin

# ---------- Database ----------
# SQLite file inside the shared docker volume mounted at /data.
# Both the API and Celery worker containers read/write this same file.
DATABASE_URL=sqlite:////data/subly.db
